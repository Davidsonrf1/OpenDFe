<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenDFe</RootNamespace>
    <Description>Núcleo da OpenDFe: contratos, certificado, assinatura XMLDSig, SOAP, TLS ICP-Brasil e validação pelo XSD dos documentos fiscais eletrônicos brasileiros.</Description>
  </PropertyGroup>

  <!-- XMLDSig (SignedXml, C14N): não faz parte do framework compartilhado. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <!-- As ACs raiz da ICP-Brasil vigentes, baixadas do ITI na etapa 1.7 (PROJETO.md 8.5). -->
  <ItemGroup>
    <EmbeddedResource Include="Raizes/*.crt" LogicalName="Raizes/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenDFe.Nucleo.Testes" />
    <InternalsVisibleTo Include="OpenDFe.Homologacao.Testes" />
  </ItemGroup>

</Project>
