<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Renderizador PDF do modelo de impressão da OpenDFe (DANFE, DANFCE e DANFSe). Usa o QuestPDF, que tem licença própria: leia o README antes de usar.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenDFe.Nucleo/OpenDFe.Nucleo.csproj" />
  </ItemGroup>

  <!-- A licença do QuestPDF não é a do resto da OpenDFe (PROJETO.md 10.2); o pacote tem README próprio, com ela no começo. -->
  <ItemGroup>
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="../../README.md" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="OpenDFe.Impressao.Pdf.Testes" />
    <!-- Os testes dos documentos completos (DANFCE e DANFE) e da ponta a ponta com o emulador moram no NFe.Testes (CONTRATOS.md 22.7). -->
    <InternalsVisibleTo Include="OpenDFe.NFe.Testes" />
    <!-- O DANFSe (9.5): os mesmos arquivos de teste do PDF (PdfVetores usa as larguras do Code 128). -->
    <InternalsVisibleTo Include="OpenDFe.NFSe.Testes" />
  </ItemGroup>

</Project>
