<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- SEFAZ emulada (PROJETO.md 13.5): servidor local que responde como os autorizadores, só para testes.
       Fora dos pacotes publicados; roda sozinho (dotnet run) ou dentro dos testes. -->
  <PropertyGroup>
    <RootNamespace>OpenDFe.SefazEmulada</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenDFe.SefazEmulada.Testes" />
  </ItemGroup>

  <!-- A página do painel (E.6), embutida como está, sem build: Painel/<arquivo>. -->
  <ItemGroup>
    <EmbeddedResource Include="Painel/*" LogicalName="Painel/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Da lib, só o que é neutro (13.5): o SchemaXml com os XSDs do leiaute e a verificação da assinatura. -->
  <ItemGroup>
    <ProjectReference Include="../../src/OpenDFe.Leiaute.NFe.v400/OpenDFe.Leiaute.NFe.v400.csproj" />
  </ItemGroup>

</Project>
