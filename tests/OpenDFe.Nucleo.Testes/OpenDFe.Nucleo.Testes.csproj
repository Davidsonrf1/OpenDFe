<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenDFe.Testes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OpenDFe.Nucleo/OpenDFe.Nucleo.csproj" />
  </ItemGroup>

  <!-- O gerador do certificado de teste (PROJETO.md 13.1), compartilhado entre os projetos de teste. -->
  <ItemGroup>
    <Compile Include="../Compartilhado/**/*.cs" LinkBase="Compartilhado" />
  </ItemGroup>

  <!-- Os XSDs de exemplo da validação pelo schema (Schemas/), embutidos como o leiaute vai embutir os da
       SEFAZ: o nome do recurso é o caminho (SchemaXml.Carregar). -->
  <ItemGroup>
    <EmbeddedResource Include="Schemas/**/*.xsd" LogicalName="Schemas/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
