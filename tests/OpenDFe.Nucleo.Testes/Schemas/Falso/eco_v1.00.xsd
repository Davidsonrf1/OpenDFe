<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema falso, só para os testes dos contratos (1.6): as mensagens do leiaute falso (Falso/LeiauteFalso.cs).
     O ecoLote exige a assinatura de cada eco, para provar que o núcleo assina antes de validar. -->
<xs:schema xmlns="urn:opendfe:teste:eco" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:opendfe:teste:eco" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:simpleType name="TTexto">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="consStatus">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="tpAmb">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="1"/>
              <xs:enumeration value="2"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="versao" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="ecoLote">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="eco" maxOccurs="100">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="infEco">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="texto" type="TTexto"/>
                  </xs:sequence>
                  <xs:attribute name="Id" type="xs:ID" use="required"/>
                </xs:complexType>
              </xs:element>
              <xs:any namespace="http://www.w3.org/2000/09/xmldsig#" processContents="skip"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
