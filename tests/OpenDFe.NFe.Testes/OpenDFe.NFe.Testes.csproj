<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenDFe.Testes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OpenDFe.Leiaute.NFe.v400/OpenDFe.Leiaute.NFe.v400.csproj" />
    <!-- O leiaute leva o modelo como referência privada (sai no mesmo pacote); o teste o usa direto. -->
    <ProjectReference Include="../../src/OpenDFe.NFe.Modelo/OpenDFe.NFe.Modelo.csproj" />
  </ItemGroup>

  <!-- O PDF do DANFE e do DANFCE (etapa 7.4): os documentos completos e a ponta a ponta com o emulador moram aqui, onde
       as notas dos golden e a infraestrutura do emulador já estão (sem duplicar); o PdfPig lê o PDF de volta e o QRCoder
       dá a matriz de referência do QR Code. -->
  <ItemGroup>
    <ProjectReference Include="../../src/OpenDFe.Impressao.Pdf/OpenDFe.Impressao.Pdf.csproj" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="QRCoder" />
    <!-- O leitor do PDF e as matrizes do QR Code e do código de barras são os mesmos do Impressao.Pdf.Testes (um arquivo só). -->
    <Compile Include="../OpenDFe.Impressao.Pdf.Testes/PdfLeitor.cs" Link="Impressao/PdfLeitor.cs" />
    <Compile Include="../OpenDFe.Impressao.Pdf.Testes/PdfVetores.cs" Link="Impressao/PdfVetores.cs" />
  </ItemGroup>

  <!-- As operações pela lib contra a SEFAZ emulada (PROJETO.md 13.5), da 4.3 em diante: o leiaute de verdade com as
       URLs do emulador trocadas e a AC dele pela fábrica de teste. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../OpenDFe.SefazEmulada/OpenDFe.SefazEmulada.csproj" />
  </ItemGroup>

  <!-- O gerador do certificado de teste (PROJETO.md 13.1): a nota escrita é assinada antes do schema, que exige a Signature. -->
  <ItemGroup>
    <Compile Include="../Compartilhado/**/*.cs" LinkBase="Compartilhado" />
  </ItemGroup>

  <!-- Os XMLs de exemplo (PLANO.md, estrutura), com os bytes como estão, para a leitura (2.5). -->
  <ItemGroup>
    <None Include="../Exemplos/**/*.xml" LinkBase="Exemplos" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- O catálogo das rejeições (REGRAS.md 10), que o teste cruza com as regras do leiaute (3.1). -->
  <ItemGroup>
    <None Include="../../docs/REGRAS.md" Link="docs/REGRAS.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
